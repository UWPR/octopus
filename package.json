{
  "name": "octopus",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://uwpr.github.io/octopus",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.86",
    "@types/react": "^18.2.63",
    "@types/react-dom": "^18.2.20",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/sync-doc-version.js",
    "build:singlefile": "cross-env PUBLIC_URL=. REACT_APP_SINGLEFILE=1 GENERATE_SOURCEMAP=false react-scripts build && node scripts/inline.js",
    "test": "react-scripts test",
    "test:all": "react-scripts test --watchAll=false",
    "test:greedyPlacement": "react-scripts test --watchAll=false --testPathPattern=greedySpatialPlacement",
    "test:blockCapacities": "react-scripts test --watchAll=false --testPathPattern=assignBlockCapacities",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/tests/e2e/**/*.{ts,tsx}"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off",
          "jest/no-conditional-expect": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.58.2",
    "@types/papaparse": "^5.3.14",
    "cross-env": "^10.1.0",
    "fast-check": "^3.23.2",
    "gh-pages": "^6.1.1"
  }
}
